---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<SocialLinks />
	</nav>
</header>
<style>
	header {
		margin: 0 auto;
		width: 600px;
		max-width: calc(100% - 2em);
		padding: 2em 1em 0 1em;
	}
	h2 {
		margin: 0;
		font-size: 1.6em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--heading));
	}
	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5em 1em;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
	}
	.internal-links a {
		padding: 0 0.6em 0.3em 0.6em;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.85em;
		border-bottom: 2px solid transparent;
		transition: color 0.2s ease;
	}
	.internal-links a:first-child {
		padding-left: 0;
	}
	.internal-links a:hover {
		color: rgb(var(--accent));
	}
	.internal-links a.active {
		color: rgb(var(--accent));
		border-bottom-color: rgb(var(--accent2));
	}
	:global(nav .social-links) {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	:global(nav .social-links a) {
		display: flex;
		color: rgb(var(--accent2));
	}
	:global(nav .social-links a:hover) {
		color: rgb(var(--accent));
	}
	:global(nav .social-links svg) {
		width: 20px;
		height: 20px;
	}
	@media (max-width: 720px) {
		:global(nav .social-links) {
			display: none;
		}
	}
</style>
