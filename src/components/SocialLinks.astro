---
const socialLinks = [
    {
        href: "https://twitter.com/kaybuilds",
        descr: "Follow Kay on Twitter",
        viewBox: "0 0 24 24", // Standard 24x24
        path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
    },
    {
        href: "https://github.com/kayanhales",
        descr: "Go to Kay's GitHub repo",
        viewBox: "0 0 16 16", // GitHub's native 16x16 viewBox
        path: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
    },
    {
        href: "/rss.xml",
        descr: "Subscribe via RSS",
        viewBox: "0 0 24 24",
        path: "M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"
    },
];
---
<div class="social-links">
    {
        socialLinks.map((link) => { // or socialLinks.map
            return (
                <a href={link.href} target="_blank">
                    <span class="sr-only">{link.descr}</span>
                    <svg viewBox={link.viewBox} aria-hidden="true" width="32" height="32">
                        <path fill="currentColor" d={link.path}></path>
                    </svg>
                </a>
            );
        })
    }
</div>