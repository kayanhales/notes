---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<aside class="toc" aria-label="Table of contents">
			<p class="toc-label">on this page</p>
			<ul>
				{items.map((h) => (
					<li class:list={[`depth-${h.depth}`]}>
						<a href={`#${h.slug}`} data-slug={h.slug}>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.toc {
		display: none;
		position: fixed;
		top: 8em;
		left: calc(50% + 340px);
		width: 220px;
		max-height: calc(100vh - 10em);
		overflow-y: auto;
	}
	@media (min-width: 1280px) {
		.toc {
			display: block;
		}
	}
	.toc-label {
		margin: 0 0 0.6em 0;
		font-size: 0.7em;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid rgb(var(--gray-light));
	}
	.toc li {
		margin: 0;
	}
	.toc a {
		display: block;
		padding: 0.35em 0 0.35em 0.9em;
		margin-left: -2px;
		border-left: 2px solid transparent;
		font-size: 0.8em;
		line-height: 1.3;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.toc li.depth-3 a {
		padding-left: 1.8em;
		font-size: 0.75em;
	}
	.toc a:hover {
		color: rgb(var(--accent));
	}
	.toc a.active {
		color: rgb(var(--heading));
		border-left-color: rgb(var(--accent2));
		font-weight: 700;
	}
</style>

<script>
	function initToc() {
		const links = document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]');
		if (!links.length) return;

		const headingEls = Array.from(links)
			.map((link) => document.getElementById(link.dataset.slug || ''))
			.filter((el): el is HTMLElement => el !== null);

		const setActive = (slug: string) => {
			links.forEach((link) => {
				link.classList.toggle('active', link.dataset.slug === slug);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((e) => e.isIntersecting);
				if (visible.length > 0) {
					setActive(visible[0].target.id);
				}
			},
			{ rootMargin: '-10% 0px -70% 0px' },
		);

		headingEls.forEach((el) => observer.observe(el));
	}

	initToc();
	document.addEventListener('astro:page-load', initToc);
</script>
