---
const today = new Date();
import SocialLinks from './SocialLinks.astro';
---

<footer>
	<div class="footer-content">
		<span class="copyright">&copy; {today.getFullYear()} Kayan Clarke. All rights reserved.</span>
		<SocialLinks />
	</div>
</footer>
<style>
	footer {
		width: 600px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 1em 4em 1em;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-content {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.copyright {
		font-size: 0.75em;
	}
	.footer-content :global(.social-links) {
		display: flex;
		align-items: center;
		gap: 0.6em;
		margin: 0;
	}
	.footer-content :global(.social-links a) {
		display: flex;
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.footer-content :global(.social-links a:hover) {
		color: rgb(var(--accent));
	}
	.footer-content :global(.social-links svg) {
		width: 13px;
		height: 13px;
	}
</style>
