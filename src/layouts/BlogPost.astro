---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { getReadingTime } from '../utils/readingTime';

type Props = CollectionEntry<'blog'>['data'] & {
	id?: string;
	headings?: { depth: number; slug: string; text: string }[];
	related?: CollectionEntry<'blog'>[];
};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	related = [],
} = Astro.props;

const ogImage = id ? new URL(`/og/${id}.png`, Astro.site).toString() : undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage={ogImage} />
		<style>
			.breadcrumb {
				margin-bottom: 2em;
			}
			.hero-image {
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 auto;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
			}
			.title h1 {
				margin: 0;
			}
			.meta {
				margin: 0.4em 0 1em 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.title :global(.tag-list) {
				margin-bottom: 2em;
			}
			.related {
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related h2 {
				font-size: 1.5em;
				margin-bottom: 1em;
			}
			.related ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.related li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.related a {
				display: flex;
				flex-direction: column;
				gap: 0.2em;
				padding: 0.85em 0;
				text-decoration: none;
				color: rgb(var(--black));
			}
			.related .date {
				font-size: 0.7em;
				color: rgb(var(--gray));
			}
			.related .title {
				margin: 0;
				font-size: 1em;
			}
			.related a:hover .title {
				text-decoration: underline;
				text-decoration-color: rgb(var(--accent2));
				text-decoration-thickness: 2px;
			}
		</style>
	</head>

	<body>
		<div id="reading-progress"></div>
		<Header />
		<main>
			<article>
				<a class="btn breadcrumb" href="/blog">&larr; view all notes</a>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										{' '}
										&middot; updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<TagList tags={tags} />
					</div>
					<slot />
				</div>
				{
					related.length > 0 && (
						<div class="related">
							<h2>Related notes</h2>
							<ul>
								{related.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											<span class="date">
												<FormattedDate date={post.data.pubDate} />
												{' · '}
												{getReadingTime(post.body ?? '')}
											</span>
											<span class="title">{post.data.title}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</article>
			<TableOfContents headings={headings} />
		</main>
		<Footer />
	</body>
</html>

<script>
	let removeScrollListener: (() => void) | undefined;

	function initReadingProgress() {
		removeScrollListener?.();
		const bar = document.getElementById('reading-progress');
		if (!bar) return;

		function update() {
			const scrollTop = window.scrollY;
			const docHeight = document.documentElement.scrollHeight - window.innerHeight;
			const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
			if (bar) bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
		}

		window.addEventListener('scroll', update, { passive: true });
		removeScrollListener = () => window.removeEventListener('scroll', update);
		update();
	}

	initReadingProgress();
	document.addEventListener('astro:page-load', initReadingProgress);
</script>
