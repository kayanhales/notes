---
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';

const recentPosts = (await getPublishedPosts())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="intro">
				<span class="brand">Welcome!</span> Here, you'll find my notes on a variety of topics,
				including <span class="topic topic-a">technology</span>, <span class="topic topic-b">faith</span>,
				<span class="topic topic-c">career</span>, <span class="topic topic-d">motherhood</span>,
				<span class="topic topic-e">immigration</span> and <span class="topic topic-a">everyday life</span>.
			</h1>
			<section class="recent-posts">
				<ul>
					{
						recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<div class="meta">
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span aria-hidden="true">&middot;</span>
										<span class="read-time">{getReadingTime(post.body ?? '')}</span>
									</div>
									<h4 class="title">{post.data.title}</h4>
									<p class="teaser">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
				<a href="/blog" class="btn all-link">view all notes &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.intro {
		color: rgb(var(--gray-dark));
	}
	.intro .brand {
		font-family: var(--font-logo);
		color: rgb(var(--heading));
	}
	.intro .topic {
		display: inline-block;
		padding: 0 0.25em;
		border-radius: 0.35em;
		white-space: nowrap;
	}
	.topic-a {
		background: rgb(var(--accent2));
		color: #fff;
	}
	.topic-b {
		background: rgb(var(--heading));
		color: #fff;
	}
	.topic-c {
		background: rgb(var(--accent));
		color: #fff;
	}
	.topic-d {
		background: rgb(var(--mint));
		color: rgb(var(--heading));
	}
	.topic-e {
		background: rgb(var(--lime));
		color: #fff;
	}
	.recent-posts {
		margin-top: 3em;
	}
	.recent-posts ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.recent-posts li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent-posts ul a {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		padding: 1em 0;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.recent-posts .meta {
		display: flex;
		gap: 0.4em;
		white-space: nowrap;
		font-size: 0.7em;
		color: rgb(var(--gray));
	}
	.recent-posts .title {
		margin: 0;
	}
	.recent-posts .teaser {
		margin: 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.recent-posts a:hover .title {
		text-decoration: underline;
		text-decoration-color: rgb(var(--accent2));
		text-decoration-thickness: 2px;
	}
	.all-link {
		margin-top: 1.5em;
	}
</style>
