---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../utils/readingTime';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			h1 {
				margin-bottom: 0.6em;
			}
			.search-row {
				display: flex;
				align-items: center;
				gap: 1em;
				margin-bottom: 1.5em;
			}
			.search-input {
				flex: 1;
				padding: 0.7em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: rgb(var(--card-bg));
				font-family: var(--font-sans);
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}
			.search-input:focus {
				outline: 2px solid rgb(var(--accent2));
				outline-offset: 1px;
			}
			.tags-link {
				flex-shrink: 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-decoration: none;
				white-space: nowrap;
			}
			.tags-link:hover {
				color: rgb(var(--accent));
			}
			.empty-message {
				display: none;
				padding: 2em 0;
				color: rgb(var(--gray));
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			a.row {
				display: flex;
				flex-direction: column;
				gap: 0.2em;
				padding: 1em 0 0.5em 0;
				text-decoration: none;
				color: rgb(var(--black));
			}
			.meta {
				display: flex;
				gap: 0.4em;
				white-space: nowrap;
				font-size: 0.7em;
				color: rgb(var(--gray));
			}
			.title {
				margin: 0;
			}
			.teaser {
				margin: 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			a.row:hover .title {
				text-decoration: underline;
				text-decoration-color: rgb(var(--accent2));
				text-decoration-thickness: 2px;
			}
			li :global(.tag-list) {
				margin: 0 0 0.9em 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Notes</h1>
			<div class="search-row">
				<input
					type="search"
					class="search-input"
					id="search"
					placeholder="Search by title or tag..."
					aria-label="Search notes by title or tag"
				/>
				<a class="tags-link" href="/tags">browse by tag →</a>
			</div>
			<ul id="post-list">
				{
					posts.map((post) => (
						<li
							data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
						>
							<a class="row" href={`/blog/${post.id}/`}>
								<div class="meta">
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span aria-hidden="true">&middot;</span>
									<span class="read-time">{getReadingTime(post.body ?? '')}</span>
								</div>
								<h4 class="title">{post.data.title}</h4>
								<p class="teaser">{post.data.description}</p>
							</a>
							<TagList tags={post.data.tags} />
						</li>
					))
				}
			</ul>
			<p class="empty-message" id="empty-message">No notes match your search.</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	const input = document.getElementById('search') as HTMLInputElement;
	const items = [...document.querySelectorAll<HTMLLIElement>('#post-list li')];
	const emptyMessage = document.getElementById('empty-message');

	input.addEventListener('input', () => {
		const query = input.value.trim().toLowerCase();
		let visibleCount = 0;
		for (const item of items) {
			const matches = !query || (item.dataset.search ?? '').includes(query);
			item.style.display = matches ? '' : 'none';
			if (matches) visibleCount++;
		}
		if (emptyMessage) {
			emptyMessage.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	});
</script>
