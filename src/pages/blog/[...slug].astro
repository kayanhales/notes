---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => {
		const related = posts
			.filter((p) => p.id !== post.id && p.data.tags.some((tag) => post.data.tags.includes(tag)))
			.sort((a, b) => {
				const aShared = a.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
				const bShared = b.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
				if (bShared !== aShared) return bShared - aShared;
				return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
			})
			.slice(0, 3);
		return {
			params: { slug: post.id },
			props: { post, related },
		};
	});
}
type Props = { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[] };

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} id={post.id} headings={headings} related={related}>
	<Content />
</BlogPost>
